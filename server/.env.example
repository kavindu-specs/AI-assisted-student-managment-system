# Server
PORT=4000
NODE_ENV=development
CLIENT_ADMIN_ORIGIN=http://localhost:5173
CLIENT_STUDENT_ORIGIN=http://localhost:5174

# Multi-process serving (see server.js). Leave CLUSTER_WORKERS unset to
# default to one worker per CPU core; set CLUSTER_ENABLED=false to run as a
# single process (useful for local debugging with an attached debugger).
CLUSTER_ENABLED=true
CLUSTER_WORKERS=

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=rajarata_sms
DB_USER=root
DB_PASSWORD=
# Per-worker connection pool cap - MySQL sees up to (DB_POOL_MAX * CLUSTER_WORKERS)
# connections total, so keep this modest rather than raising it per-instance.
DB_POOL_MAX=5

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h
PRE_AUTH_TOKEN_EXPIRES_IN=10m
BCRYPT_SALT_ROUNDS=10
ADMIN_EMAIL_DOMAIN=agri.rjt.ac.lk
OTP_TTL_MINUTES=5
TEMP_PASSWORD_VALID_DAYS=7

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# Mail (stub provider - fill in for real delivery)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@rjt.ac.lk
